{
  "name": "committer",
  "version": "1.0.0",
  "description": "Git commit message auto generation tool",
  "main": "index.js",
  "bin": {
    "committer": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "format": "prettier --write \"src/**/*.{ts,js}\" \"config/**/*.{yaml,yml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js}\" \"config/**/*.{yaml,yml}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmed-alzahrani/committer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ahmed-alzahrani/committer/issues"
  },
  "homepage": "https://github.com/ahmed-alzahrani/committer#readme",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "inquirer": "^13.1.0",
    "js-yaml": "^4.1.1",
    "ora": "^9.0.0",
    "simple-git": "^3.30.0"
  }
}
